{% extends 'base.html.twig' %}

{% block title %}Twiter{% endblock %}

{% block body %}
    <h1 class="page-title">Lo último</h1>
    {% if tweets|length > 0 %}
        <div class="feed" aria-live="polite">
            {{ include('main/_tweets_page.html.twig') }}
        </div>
    {% else %}
        <p class="empty">No se han encontrado Tweets</p>
    {% endif %}
{% endblock %}
