{% extends "base.html.twig" %}
{% block title %}
   {{ hashtag }}
{% endblock %}
{% block body %}
    <h1 class="page-title">#{{ hashtag }}</h1>
    {% if tweets %}
        {% for tweet in tweets %}
            {{include('partials/_tweet.html.twig', {'tweet': tweet})}}
        {% endfor %}
    {% else %}
        <p class="empty">Hashtag no encontrado</p>
    {% endif %}
{% endblock %}
