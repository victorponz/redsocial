{% extends 'base.html.twig' %}

{% block title %}Twiter{% endblock %}

{% block body %}
    <h1 class="page-title">Lo último</h1>
    {% if tweets %}
        {% for tweet in tweets %}
            {{include('partials/_tweet.html.twig', {'tweet': tweet})}}
        {% endfor %}
    {% else %}
        <p class="empty">No se han encontrado Tweets</p>
    {% endif %}
{% endblock %}
