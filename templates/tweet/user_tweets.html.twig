{% extends "base.html.twig" %}
{% block title %}
	{% if tweetUser %}
		{{tweetUser.username}}{% else %}Usuario no encontrado
	{% endif %}
{% endblock %}
{% block body %}
	{% if tweetUser %}
		<div class="user-header">
			<h1>@{{tweetUser.username}}</h1>
			{% if app.user and (app.user.id != tweetUser.id) %}
				<a class="btn" href="{{path('user_follow', {'username': tweetUser.username})}}">Seguir</a>
			{% endif %}
		</div>
		{% for tweet in tweets %}
			{{include('partials/_tweet.html.twig', {'tweet': tweet})}}
		{% else %}
			<p class="empty">Este usuario aún no ha publicado nada</p>
		{% endfor %}
	{% else %}
		<p class="empty">Usuario no encontrado</p>
	{% endif %}
{% endblock %}
