<article class='tweet' data-id='{{tweet.id}}'>
	<div class='tweet_header'>
		<ul>
			<li>
				<a href="{{path('user_profile', {'username': tweet.user.username})}}">
					{% if tweet.user.avatar %}
						<img class="tweet-avatar" src="{{ asset('assets/images/' ~ tweet.user.avatar) }}" alt="{{tweet.user.username}}">
					{% else %}
						<span class="tweet-avatar-placeholder" aria-label="{{tweet.user.username}}">{{ tweet.user.username|first }}</span>
					{% endif %}
				</a>
			</li>
			<li class='tweet-username'>
				<a href="{{path('user_tweets', {'username': tweet.user.username})}}">@{{tweet.user.username}}</a>
			</li>
		</ul>
	</div>
	{% if tweet.image %}
		<div class='tweet-img'><img src='{{asset('assets/images/') ~ tweet.image}}' alt=''/></div>
	{% endif %}
	<div class='tweet-content'>{{tweet.content | striptags | escape | formatMention | formatHashtag | formatURL| raw}}</div>
	<ul class='tweet-footer'>
		<li class='tweet-date'>
			<span class='timeago'>{{tweet.date | date('c')}}</span>
		</li>
		{% if tweet.user.id != (app.user.id ?? -1)%}
			<li class='tweet-like'>
				<a href="{{path('tweet_like', {'id': tweet.id})}}" data-id="{{tweet.id}}" data-wholikes="{{path('tweet_wholikes-json', {'id': tweet.id})}}" aria-describedby="likes-tooltip-{{tweet.id}}">Like <span class="tweet-like-count">{{tweet.likes}}</span></a>
				<div class="likes-tooltip" id="likes-tooltip-{{tweet.id}}" role="tooltip" hidden></div>
			</li>
		{% endif %}
	</ul>
</article>
